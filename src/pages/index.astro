---
import Layout from '../layouts/Layout.astro';
import { dayLength, hoursAndMinutes } from '../scripts/sun';

const features = [
    { title: 'To the second', body: 'See exactly how much daylight you gained or lost since yesterday, and what tomorrow brings.' },
    { title: 'Sunset, counting down', body: "Sunrise and sunset times, today's day length, and how long until the next one." },
    { title: 'Your place, anywhere', body: 'Use your location, or search for any city. The sun is worked out right on your iPhone.' },
    { title: 'Private by design', body: 'Worked out on your iPhone, and we never see your location. No accounts, no tracking, no ads.' },
];

// A year of daylight in Vancouver, worked out at build time with the app's formula.
const place = { name: 'Vancouver', latitude: 49.2827, longitude: -123.1207 };
const year = 2026;
const days = Array.from({ length: 365 }, (_, index) => {
    const date = new Date(Date.UTC(year, 0, 1 + index, 20)); // about noon in Vancouver
    return dayLength(date, place.latitude, place.longitude);
});
const longest = Math.max(...days);
const shortest = Math.min(...days);
const chart = { width: 640, height: 220, top: 16, bottom: 28 };
const x = (index: number) => (index / (days.length - 1)) * chart.width;
const y = (hours: number) => chart.top + (1 - (hours - 6) / (18 - 6)) * (chart.height - chart.top - chart.bottom);
const curve = days.map((hours, index) => `${index ? 'L' : 'M'}${x(index).toFixed(1)} ${y(hours).toFixed(1)}`).join(' ');
const area = `${curve} L${chart.width} ${chart.height - chart.bottom} L0 ${chart.height - chart.bottom} Z`;
const juneSolstice = 171; // June 21
const decemberSolstice = 354; // December 21
const months = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];

const plus = [
    { title: 'Every widget', body: "Medium and large Home Screen widgets, with the sun's path across the day, and the Lock Screen too." },
    { title: 'Golden hour', body: 'When the light turns warm, morning and evening. Good for photos, walks and dinner on the deck.' },
    { title: 'Solstice countdown', body: 'Days until the shortest or longest day, and how much light has come or gone since the last one.' },
    { title: 'More places', body: 'Keep an eye on the light where family and friends live, each in its own time zone.' },
];

const free = ["Today's daylight gained or lost", 'Sunrise, sunset and day length', 'Countdown to the next sunrise or sunset', 'The small Home Screen widget', 'Your location or any city'];
const plusOnly = ['Medium, large and Lock Screen widgets', 'Golden hour, morning and evening', 'Countdown to the solstice', 'More places to compare', 'Every theme, with matching widgets', 'Future Plus features'];

// The app's themes, for the Plus swatches. Colours match the app exactly.
const themes = [
    { id: 'dusk', name: 'Dusk', free: true, night: '#14112E', glows: ['#E0607A', '#F09A62', '#5B34A0'], accent: ['#F09A62', '#E0607A'] },
    { id: 'midnight', name: 'Midnight', night: '#05060F', glows: ['#3B3F9E', '#2A2370', '#1A1F5C'], accent: ['#A9C1FF', '#7C8CFF'] },
    { id: 'ember', name: 'Ember', night: '#1A0708', glows: ['#C24A32', '#D98B48', '#7A1E24'], accent: ['#F5C565', '#EE9A52'] },
    { id: 'aurora', name: 'Aurora', night: '#04121F', glows: ['#27A57C', '#5F47B0', '#0F5C5A'], accent: ['#9AF5D0', '#45C99A'] },
    { id: 'tidepool', name: 'Tidepool', night: '#061A26', glows: ['#358F9C', '#6FB3A9', '#16627A'], accent: ['#C9F2EA', '#8FD3C9'] },
    { id: 'bloom', name: 'Bloom', night: '#2A1638', glows: ['#E08AA4', '#E8B08A', '#7E5AC9'], accent: ['#FFDDB8', '#F7B2CB'] },
    { id: 'graphite', name: 'Graphite', night: '#0B0B0D', glows: ['#6A6D78', '#7E818B', '#3A3C44'], accent: ['#FFFFFF', '#D3D6DD'] },
];

const swatchBackground = (theme: (typeof themes)[number]) =>
    [
        `radial-gradient(70% 50% at 50% 45%, ${theme.glows[0]} 0%, transparent 70%)`,
        `radial-gradient(60% 45% at 15% 90%, ${theme.glows[1]} 0%, transparent 70%)`,
        `radial-gradient(60% 45% at 90% 15%, ${theme.glows[2]} 0%, transparent 70%)`,
        theme.night,
    ].join(', ');
---

<Layout
    title="Daylight Glow: Every minute of daylight"
    description="Daylight Glow shows how much daylight you gained or lost since yesterday, and counts down to sunset, right on your iPhone Home Screen. Calculated on your iPhone, completely private."
>
    {/* Hero */}
    <section class="mx-auto grid max-w-6xl items-center gap-16 px-6 pt-16 pb-24 sm:px-10 lg:grid-cols-[1.1fr_1fr] lg:pt-24 lg:pb-32">
        <div>
            <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold tracking-[0.14em] uppercase ring-1 ring-white/20 backdrop-blur">
                <span class="size-1.5 rounded-full bg-accent"></span>
                Coming soon to the App Store
            </p>
            <h1 class="mt-7 text-5xl font-semibold tracking-[-0.04em] text-balance sm:text-7xl">
                Every minute of&nbsp;daylight.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80 sm:text-xl">
                Daylight Glow shows how much light you gained or lost since yesterday, and counts down to sunset, right on your Home Screen. Through the long dark months, watch the minutes come back, one day at a time.
            </p>
            <p class="mt-4 max-w-xl text-sm font-medium text-white/65">
                Free to download, with the small widget included. An optional one-time Plus upgrade adds every widget size, golden hour, the solstice countdown, more places and every theme.
            </p>
            <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 text-sm text-white/70">
                <div><dt class="sr-only">Accounts</dt><dd><span class="block text-2xl font-semibold tracking-tight text-white">No</span>sign-up needed</dd></div>
                <div><dt class="sr-only">Widgets</dt><dd><span class="block text-2xl font-semibold tracking-tight text-white">6</span>widget styles</dd></div>
                <div><dt class="sr-only">Data collected</dt><dd><span class="block text-2xl font-semibold tracking-tight text-white">0</span>data collected</dd></div>
            </dl>
        </div>

        <div class="mx-auto w-full max-w-[19rem]">
            <div class="rounded-[3.2rem] bg-black p-2.5 shadow-2xl shadow-black/50 ring-1 ring-white/15">
                <img
                    class="block aspect-[600/1304] w-full rounded-[2.6rem] bg-night object-cover"
                    src="/media/daylightglow-today.jpg"
                    width="600"
                    height="1304"
                    alt="Daylight Glow on an iPhone: Saturday, October 17 in Vancouver, minus 3 minutes 32 seconds, less daylight than yesterday. Sunrise 7:36 AM, sunset 6:18 PM, golden hour, and 65 days until the shortest day."
                />
            </div>
        </div>
    </section>

    {/* Features */}
    <section class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
        <h2 class="max-w-2xl text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">Know the light.</h2>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {features.map((feature, index) => (
                <div class="rounded-3xl bg-white/[0.07] p-6 ring-1 ring-white/15 backdrop-blur-md">
                    <p class="text-sm font-semibold tabular-nums text-white/50">0{index + 1}</p>
                    <h3 class="mt-6 text-lg font-semibold tracking-tight">{feature.title}</h3>
                    <p class="mt-2 leading-relaxed text-white/75">{feature.body}</p>
                </div>
            ))}
        </div>
    </section>

    {/* Widgets */}
    <section class="mx-auto max-w-6xl px-6 pb-28 sm:px-10">
        <div class="grid items-center gap-12 lg:grid-cols-2">
            <div class="order-2 lg:order-1">
                <h2 class="text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">One look. That's it.</h2>
                <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/80">
                    Daylight Glow lives where your eyes already go. The widget shows today's change in daylight and counts down to sunset, and the larger sizes trace the sun's path across the sky. It updates through the day on its own, so you never have to open the app.
                </p>
            </div>

            <div class="order-1 flex flex-wrap items-end justify-center gap-6 lg:order-2">
                <div class="w-60 rounded-[2.8rem] bg-black p-2 shadow-2xl shadow-black/50 ring-1 ring-white/15">
                    <img
                        class="block aspect-[600/1304] w-full rounded-[2.3rem] object-cover"
                        src="/media/daylightglow-home.jpg"
                        width="600"
                        height="1304"
                        loading="lazy"
                        alt="An iPhone Home Screen with the large Daylight Glow widget: minus 3 minutes 32 seconds, the sun's path, sunrise, sunset, golden hour and the shortest day."
                    />
                </div>

                {/* Lock Screen */}
                <div class="w-56 rounded-[1.75rem] bg-black/35 p-5 text-center ring-1 ring-white/15 backdrop-blur-md" aria-hidden="true">
                    <p class="text-xs font-semibold text-white/80">Sat 17 · Sunset 6:18 PM</p>
                    <p class="mt-1 text-6xl font-semibold tracking-tight tabular-nums">4:52</p>
                    <div class="mt-4 flex items-center gap-3 text-left">
                        <svg viewBox="0 0 44 44" class="size-12 shrink-0">
                            <circle cx="22" cy="22" r="18" fill="none" stroke="rgb(255 255 255 / 0.25)" stroke-width="4" stroke-dasharray="84.8 28.3" transform="rotate(135 22 22)" stroke-linecap="round" />
                            <circle cx="22" cy="22" r="18" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-dasharray="72 113.1" transform="rotate(135 22 22)" />
                            <text x="22" y="26" text-anchor="middle" fill="white" font-size="10" font-weight="600">−3m</text>
                        </svg>
                        <div class="min-w-0 flex-1">
                            <p class="text-xl leading-none font-semibold tabular-nums">−3m 32s</p>
                            <p class="mt-1 text-[0.65rem] font-medium text-white/80">daylight vs yesterday</p>
                            <p class="mt-0.5 text-[0.65rem] font-semibold">Sunset 6:18 PM</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {/* A year of daylight */}
    <section class="mx-auto max-w-6xl px-6 pb-28 sm:px-10">
        <div class="rounded-[2rem] bg-white/[0.07] p-8 ring-1 ring-white/15 backdrop-blur-md sm:p-12">
            <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.3fr]">
                <div>
                    <p class="flex items-baseline gap-3">
                        <span class="text-7xl font-semibold tracking-[-0.05em] tabular-nums sm:text-8xl" data-solstice-days>65</span>
                        <span class="text-lg font-medium text-white/75" data-solstice-label>days to the shortest day</span>
                    </p>
                    <h2 class="mt-6 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">The turn is coming.</h2>
                    <p class="mt-4 max-w-md text-lg leading-relaxed text-white/80">
                        In {place.name}, the longest day has {hoursAndMinutes(longest)} of light and the shortest just {hoursAndMinutes(shortest)}. With Plus, Daylight Glow counts down to the solstice and keeps track of how much light has gone, or come back, since the last one.
                    </p>
                </div>

                <figure>
                    <svg viewBox={`0 0 ${chart.width} ${chart.height}`} class="block w-full overflow-visible" role="img" aria-label={`Hours of daylight in ${place.name} through ${year}: about ${hoursAndMinutes(shortest)} in late December, rising to ${hoursAndMinutes(longest)} in late June.`}>
                        <defs>
                            <linearGradient id="daylight-fill" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.55" />
                                <stop offset="100%" stop-color="var(--color-accent-2)" stop-opacity="0.05" />
                            </linearGradient>
                        </defs>
                        {[8, 12, 16].map((hours) => (
                            <g>
                                <line x1="0" x2={chart.width} y1={y(hours)} y2={y(hours)} stroke="white" stroke-opacity="0.12" stroke-dasharray="3 5" />
                                <text x="4" y={y(hours) - 5} fill="white" fill-opacity="0.5" font-size="11" font-weight="600">{hours}h</text>
                            </g>
                        ))}
                        <path d={area} fill="url(#daylight-fill)" />
                        <path d={curve} fill="none" stroke="white" stroke-width="2.5" stroke-linejoin="round" />
                        <circle cx={x(juneSolstice)} cy={y(days[juneSolstice])} r="4" fill="white" />
                        <text x={x(juneSolstice)} y={y(days[juneSolstice]) - 10} text-anchor="middle" fill="white" font-size="11" font-weight="600">Longest day</text>
                        <circle cx={x(decemberSolstice)} cy={y(days[decemberSolstice])} r="4" fill="white" />
                        <text x={x(decemberSolstice)} y={y(days[decemberSolstice]) + 18} text-anchor="middle" fill="white" font-size="11" font-weight="600">Shortest</text>
                        <g data-today hidden>
                            <line y1={chart.top} y2={chart.height - chart.bottom} stroke="white" stroke-opacity="0.6" />
                            <circle r="6" fill="var(--color-accent)" stroke="white" stroke-width="2" />
                            <text text-anchor="middle" fill="white" font-size="11" font-weight="700">Today</text>
                        </g>
                        {months.map((month, index) => (
                            <text x={x(index * 30.4 + 15)} y={chart.height - 6} text-anchor="middle" fill="white" fill-opacity="0.5" font-size="11" font-weight="600">{month}</text>
                        ))}
                    </svg>
                    <figcaption class="mt-3 text-xs font-medium text-white/60">Hours of daylight in {place.name}, {year}</figcaption>
                </figure>
            </div>
        </div>
    </section>

    {/* Plus */}
    <section id="plus" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24 sm:px-10">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold tracking-[0.14em] uppercase ring-1 ring-white/20 backdrop-blur">
            <span class="size-1.5 rounded-full bg-accent"></span>
            Optional upgrade
        </p>
        <h2 class="mt-6 max-w-3xl text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-6xl">Daylight Glow Plus</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80 sm:text-xl">
            The free app does the job. Plus is one small, one-time purchase for people who want more of the sky. No subscription, and Family Sharing is included.
        </p>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {plus.map((item) => (
                <div class="rounded-3xl bg-white/[0.07] p-6 ring-1 ring-white/15 backdrop-blur-md">
                    <span class="glow-met inline-flex size-7 items-center justify-center rounded-full text-sm font-bold" aria-hidden="true">+</span>
                    <h3 class="mt-5 text-lg font-semibold tracking-tight">{item.title}</h3>
                    <p class="mt-2 leading-relaxed text-white/75">{item.body}</p>
                </div>
            ))}
        </div>
    </section>

    {/* Themes */}
    <section class="mx-auto max-w-6xl px-6 pb-24 sm:px-10">
        <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto]">
            <div>
                <h2 class="text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">Seven skies.</h2>
                <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/80">
                    Dusk is free. The other six come with Plus, and your widgets change to match.
                </p>
            </div>
            <p class="text-sm font-medium text-white/60">Go on, tap one.</p>
        </div>

        <ul class="mt-10 flex snap-x gap-4 overflow-x-auto pb-4 [scrollbar-width:none] lg:grid lg:grid-cols-7 lg:overflow-visible" aria-label="Try a theme on this page">
            {themes.map((theme) => (
                <li class="shrink-0 snap-start">
                    <button
                        type="button"
                        data-theme-pick={theme.id}
                        aria-pressed={theme.free ? 'true' : 'false'}
                        class="group flex w-32 flex-col items-center gap-3 rounded-[1.6rem] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white lg:w-full"
                    >
                        <span
                            class="relative flex aspect-[9/14] w-full flex-col justify-end overflow-hidden rounded-[1.4rem] p-3 text-left ring-1 ring-white/15 transition group-hover:-translate-y-1 group-aria-pressed:ring-2 group-aria-pressed:ring-white motion-reduce:transition-none"
                            style={`background: ${swatchBackground(theme)}`}
                        >
                            <span class="text-xl leading-none font-semibold tracking-tight tabular-nums">−3m 32s</span>
                            <span class="mt-0.5 text-[0.6rem] font-medium text-white/75">daylight</span>
                            <span class="mt-2.5 h-1 w-full rounded-full" style={`background: linear-gradient(90deg, ${theme.accent[0]}, ${theme.accent[1]})`} aria-hidden="true"></span>
                            <img src={`/icons/${theme.id}.png`} alt="" class="absolute top-3 right-3 size-7 rounded-[22%]" width="28" height="28" loading="lazy" />
                        </span>
                        <span class="flex items-center gap-1.5 text-sm font-semibold">
                            {theme.name}
                            <span class="rounded-full bg-white/10 px-1.5 py-0.5 text-[0.6rem] font-bold tracking-wide text-white/70 uppercase">{theme.free ? 'Free' : 'Plus'}</span>
                        </span>
                    </button>
                </li>
            ))}
        </ul>
    </section>

    {/* Free vs Plus */}
    <section class="mx-auto max-w-6xl px-6 pb-28 sm:px-10">
        <h2 class="text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">Free does the job. Plus goes further.</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
            <div class="rounded-3xl bg-white/[0.06] p-7 ring-1 ring-white/15 backdrop-blur-md">
                <p class="text-sm font-semibold tracking-[0.14em] text-white/70 uppercase">Free</p>
                <ul class="mt-5 space-y-3 text-white/85">
                    {free.map((item) => (
                        <li class="flex gap-3"><span class="text-white/60" aria-hidden="true">✓</span>{item}</li>
                    ))}
                </ul>
            </div>
            <div class="rounded-3xl bg-white/[0.1] p-7 ring-2 ring-accent/60 backdrop-blur-md">
                <p class="text-sm font-semibold tracking-[0.14em] text-white/70 uppercase">Plus · one-time purchase</p>
                <p class="mt-1 text-sm text-white/70">Everything in Free, and:</p>
                <ul class="mt-4 space-y-3 text-white/85">
                    {plusOnly.map((item) => (
                        <li class="flex gap-3"><span class="glow-met inline-flex size-5 shrink-0 items-center justify-center rounded-full text-xs font-bold" aria-hidden="true">+</span>{item}</li>
                    ))}
                </ul>
            </div>
        </div>
        <p class="mt-6 max-w-2xl text-sm leading-relaxed text-white/65">
            Just want to say thanks? There's an optional tip jar in the app, too. Tips don't unlock anything; they just help keep Daylight Glow going.
        </p>
    </section>
</Layout>

<script define:vars={{ chart, days, year }}>
    // Mark today on the chart, and count the days to the next solstice.
    // Uses the visitor's own date; the curve is Vancouver's.
    const now = new Date();
    const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const dayOfYear = Math.min(Math.round((midnight - new Date(now.getFullYear(), 0, 1)) / 86400000), days.length - 1);

    const today = document.querySelector('[data-today]');
    if (today && now.getFullYear() === year) {
        const px = (dayOfYear / (days.length - 1)) * chart.width;
        const py = chart.top + (1 - (days[dayOfYear] - 6) / 12) * (chart.height - chart.top - chart.bottom);
        const line = today.querySelector('line');
        line.setAttribute('x1', px);
        line.setAttribute('x2', px);
        today.querySelector('circle').setAttribute('cx', px);
        today.querySelector('circle').setAttribute('cy', py);
        const label = today.querySelector('text');
        label.setAttribute('x', px);
        label.setAttribute('y', py - 12);
        today.removeAttribute('hidden');
    }

    // The page is written from the northern hemisphere's point of view.
    const candidates = [new Date(now.getFullYear(), 5, 21), new Date(now.getFullYear(), 11, 21), new Date(now.getFullYear() + 1, 5, 21)];
    const next = candidates.find((date) => date >= midnight);
    const daysLeft = Math.round((next - midnight) / 86400000);
    const count = document.querySelector('[data-solstice-days]');
    const label = document.querySelector('[data-solstice-label]');
    if (count && label) {
        count.textContent = String(daysLeft);
        label.textContent = `${daysLeft === 1 ? 'day' : 'days'} to the ${next.getMonth() === 11 ? 'shortest' : 'longest'} day`;
    }
</script>
